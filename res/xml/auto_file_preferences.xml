<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        android:title="@string/auto_file_title">
    <!-- Standing media-management grant (API 31+). GallerySettings removes this
         category on older releases and keeps the summary in step with the real
         grant; nothing is persisted, the system owns the state. -->
    <PreferenceCategory
            android:key="media_access_category"
            android:title="@string/media_access_category_title">
        <Preference
                android:key="media_access_manage"
                android:title="@string/media_access_manage_title"
                android:persistent="false" />
    </PreferenceCategory>
    <PreferenceCategory
            android:key="auto_file_category"
            android:title="@string/auto_file_title">
        <SwitchPreference
                android:key="auto_file_enabled"
                android:title="@string/auto_file_enabled_title"
                android:summary="@string/auto_file_enabled_summary"
                android:defaultValue="false" />
        <!-- Shown only while Auto-file is on and "Manage media without asking"
             is not allowed (Android 12+); GallerySettings adds/removes it. -->
        <Preference
                android:key="auto_file_permission_note"
                android:title="@string/auto_file_permission_note_title"
                android:summary="@string/auto_file_permission_note_summary"
                android:persistent="false" />
        <EditTextPreference
                android:key="auto_file_watched_folder"
                android:title="@string/auto_file_folder_title"
                android:summary="@string/auto_file_folder_summary"
                android:defaultValue="DCIM/Camera/"
                android:dependency="auto_file_enabled" />
        <EditTextPreference
                android:key="auto_file_delay_minutes"
                android:title="@string/auto_file_delay_title"
                android:summary="@string/auto_file_delay_summary"
                android:inputType="number"
                android:defaultValue="5"
                android:dependency="auto_file_enabled" />
    </PreferenceCategory>
    <!-- Opens HelpActivity (click handled in GallerySettings, because the
         application id differs between debug and release builds). -->
    <PreferenceCategory
            android:key="help_category"
            android:title="@string/help_title">
        <Preference
                android:key="help_open"
                android:title="@string/help_title"
                android:summary="@string/help_open_summary"
                android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
